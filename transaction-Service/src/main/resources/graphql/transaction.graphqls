type Query {
    allTransactions: [Transaction!]!
    transactionById(id: ID!): Transaction
    transactionsByAccountId(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(
        accountId: ID!,
        amount: Float!,
        currency: String!,
        merchantCategory: String,
        country: String
    ): Transaction!
}
type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
}

